{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "deployment.vercel_app:app",
      "functions": {
        "deployment/vercel_app.py": {
          "maxDuration": 300,
          "includeFiles": "data/{reference,validation}/**",
          "excludeFiles": "{frontend/**,tests/**,docs/**,scripts/**,data/raw/**,data/cache/**,.venv/**,.git/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
